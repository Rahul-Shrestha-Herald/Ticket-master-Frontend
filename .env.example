# Ticket Master – Frontend environment variables
# Copy this file to .env and fill in your values. Do not commit .env.

# Backend API base URL (required)
VITE_BACKEND_URL=http://localhost:4000

# Live tracking server URL (Socket.IO). Default: http://localhost:8000
VITE_TRACKING_URL=http://localhost:8000

# Google Gemini API key for AI chatbot (get free key from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=
